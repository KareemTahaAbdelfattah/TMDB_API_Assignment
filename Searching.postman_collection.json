    {
      "name": "GetMovieByKeyWord",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "const jsonResponse = pm.response.json()\r",
              "\r",
              "pm.test(\"Status code is 200\", function () \r",
              "{\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"Response contains results[] array\", function () {\r",
              "    const jsonData = pm.response.json();\r",
              "    pm.expect(jsonData).to.have.property(\"results\");\r",
              "    pm.expect(jsonData.results).to.be.an(\"array\");\r",
              "});\r",
              "\r",
              "pm.test(\"Validate that movie titles are relevant to the search keyword\", function () {\r",
              "    const jsonResponse = pm.response.json();\r",
              "    const keyword = pm.variables.get(\"keyword\").toLowerCase();\r",
              "\r",
              "    const matched = jsonResponse.results.some(function (movie) {\r",
              "    const title = (movie.original_title || movie.title || \"\").toLowerCase();\r",
              "    const words = title.match(/\\b[\\w']+\\b/g) || [];\r",
              "    return words.includes(keyword);\r",
              "    });\r",
              "});\r",
              "\r",
              "pm.test(\"Each result contains required fields\", function () {\r",
              "    const jsonData = pm.response.json();\r",
              "    jsonData.results.forEach(function (results) {\r",
              "        pm.expect(results).to.have.property(\"id\");\r",
              "        pm.expect(results).to.have.property(\"title\");\r",
              "        pm.expect(results).to.have.property(\"release_date\");\r",
              "        pm.expect(results).to.have.property(\"overview\");\r",
              "    });\r",
              "});\r",
              "\r",
              "pm.test(\"total_results is greater than 0\", function () {\r",
              "    const jsonData = pm.response.json();\r",
              "    pm.expect(jsonData.total_results).to.be.above(0);\r",
              "});\r",
              "\r",
              "pm.test(\"Response time is less than 400ms\", function ()\r",
              "{\r",
              "    pm.expect(pm.response.responseTime).to.be.below(400);\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
